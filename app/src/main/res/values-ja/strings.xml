    <string name="swap_zram_stat_format">圧縮アルゴリズム：%s\n元データサイズ：%s\n圧縮後サイズ：%s\n物理メモリ使用量：%s\n最大使用量：%s\n使用制限：%s\n圧縮率　　　　：%s</string>
    <string name="swap_zram_stat_format2">圧縮アルゴリズム：%s\n元データサイズ：%s\n圧縮後サイズ：%s\n圧縮率　　　　：%s</string>
    <string name="swap_zram_writback_stat">ZRAM Writeback\nライトバックブロック：%s\n書込済：%dMB\n総読込：%dMB\n総書込：%dMB</string>
